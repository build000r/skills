flowchart LR
  vision["build000r/skills: 44 reusable public agent workflows"]:::gray
  catalog["GREEN 44 SKILL.md skills, 587 tests collect clean"]:::green
  beads["GREEN Beads backlog clear: 52 of 52 closed, 0 open"]:::green
  drift["RED 14 uncommitted skill edits, no covering bead"]:::red
  fullrun["GRAY full make test / full-catalog validate not run this session (disk 94%)"]:::gray
