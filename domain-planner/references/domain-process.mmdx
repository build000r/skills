  start --> docs --> result
  start --> external --> result
  start --> auth --> result
  start --> delivery --> result
  start --> db --> result
  start --> perf --> result

  classDef high fill:#fee2e2,stroke:#dc2626,color:#7f1d1d,stroke-width:2px
