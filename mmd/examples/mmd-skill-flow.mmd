flowchart TD
  request["User: /mmd diagram.mmd"] --> command["Claude command wrapper"]
  command --> skill["mmd skill instructions"]
  skill --> script["scripts/mmd.py"]

  script --> read["Read Mermaid source"]
  read --> state["Build Mermaid Live state"]
  state --> json["Compact JSON"]
  json --> deflate["zlib/DEFLATE level 9"]
  deflate --> b64["URL-safe base64, no padding"]
  b64 --> fragment["pako: fragment"]
  fragment --> url["https://mermaid.live/edit#pako:..."]
  url --> applescript["osascript launcher"]
  applescript --> browser["Browser opens Mermaid Live Editor"]

  script --> decode["Optional: decode existing URL"]
  decode --> source["Recovered Mermaid source or JSON state"]

  browser --> improve{"Next improvements"}
  improve --> validate["Validate Mermaid syntax before opening"]
  improve --> clipboard["Copy generated URL to clipboard"]
  improve --> args["Make /mmd flags first-class"]
  improve --> shim["Add shorter executable shim"]
  improve --> drift["Check upstream serializer drift"]
