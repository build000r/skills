# Copy to .env and fill values before running install scripts.

# Anthropic API key (required for anthropic/* models).
ANTHROPIC_API_KEY=replace-with-anthropic-api-key

# OpenClaw gateway token (long random string).
OPENCLAW_GATEWAY_TOKEN=replace-with-64-plus-random-chars

# Telegram bot token from BotFather.
OPENCLAW_TG_TOKEN=123456789:replace-with-real-bot-token

# Runtime readiness inputs for Telegram group allowlist mode.
# Comma-separated format:
#   TELEGRAM_GROUP_CHAT_IDS: chatId[:topicId],chatId2[:topicId2]
#   TELEGRAM_ALLOWED_USER_IDS: userId1,userId2
TELEGRAM_GROUP_CHAT_IDS=-1001234567890
TELEGRAM_ALLOWED_USER_IDS=123456789

# SPAPS approval backend credentials.
# NOTE: Must be a public or Tailscale-routable URL — v2026.2.18 SSRF guards block private RFC1918/NAT64 ranges.
SPAPS_API_URL=https://api.unclawg.com
SPAPS_API_KEY=replace-with-spaps-api-key
SPAPS_AGENT_ID=replace-with-spaps-agent-id
SPAPS_AGENT_SECRET=replace-with-spaps-agent-secret

# Optional: auth token for cron webhook delivery to SPAPS (v2026.2.17+).
SPAPS_WEBHOOK_AUTH_TOKEN=replace-with-webhook-auth-token

# Unclawg approval portal URL.
UNCLAWG_PORTAL_URL=https://unclawg.com

# Optional: Telegram voice-note transcription via ElevenLabs STT CLI wrapper.
ELEVENLABS_API_KEY=replace-with-elevenlabs-key
ELEVENLABS_STT_MODEL_ID=scribe_v1

# Optional: explicit client label for runbooks and prompts.
CLIENT_NAME=Client Name

# Optional: app user created on droplet.
APP_USER=openclaw

# Optional: tailscale node hostname.
TAILSCALE_HOSTNAME=client-openclaw
