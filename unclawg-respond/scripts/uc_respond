    "sarcastic",
    "funnier",
)
SOUL_UPDATE_HINT_RE = re.compile(
    r"\b(?:update|refresh|rewrite|align)\b.{0,24}\b(?:soul|voice|tone|style)\b",
    re.IGNORECASE,
)
AMBIGUOUS_FEEDBACK_RE = re.compile(
    r"\b(idk|i don't know|not sure|unsure|maybe|hmm|whatever|unclear|off|feels off)\b|^\?+$",
    re.IGNORECASE,
)
DENY_NEGATION_RE = re.compile(r"\b(?:don't|dont|do not|not)\s+deny\b", re.IGNORECASE)
SAFETY_NEGATION_RE = re.compile(r"\b(?:not|isn't|isnt)\s+(?:unsafe|illegal|harmful|deceptive|dangerous)\b", re.IGNORECASE)
DENY_DIRECTIVE_RE = re.compile(
    r"\b(?:recommend|please|should|must|need to)\s+deny\b|\bdeny\s+(?:this|it|request|approval|message)\b",
    re.IGNORECASE,
)
POLICY_RISK_RE = re.compile(
    r"\b(unsafe|illegal|fraud|scam|deceptive|harmful|dangerous|exploit|malware|phish(?:ing)?|impersonat(?:e|ion))\b",
    re.IGNORECASE,
)
POLICY_VIOLATION_RE = re.compile(
    r"\b(policy|tos|terms|guideline)\b.*\b(violate|violation|against|not allowed|break)\b|\b(violate|violation)\b.*\b(policy|tos|terms|guideline)\b",
    re.IGNORECASE,
)
RISK_STATEMENT_RE = re.compile(
    r"\b(?:this|that|it)\s+(?:is|looks|seems)\s+(?:unsafe|illegal|deceptive|harmful|dangerous)\b",
    re.IGNORECASE,
)
SOUL_NO_EMOJI_RE = re.compile(r"\b(?:no|avoid|without)\s+emoji", re.IGNORECASE)
SOUL_NO_HASHTAG_RE = re.compile(r"\b(?:no|avoid|without)\s+hashtags?\b", re.IGNORECASE)
SOUL_SINGLE_SENTENCE_RE = re.compile(r"\b(?:one|single)\s+sentence\b", re.IGNORECASE)
SOUL_NO_EXCLAIM_RE = re.compile(r"\b(?:no|avoid|without)\s+exclamation", re.IGNORECASE)
REPLACE_DIRECTIVE_RE = re.compile(r"\breplace\s+['\"]?(.+?)['\"]?\s+with\s+['\"]?(.+?)['\"]?(?:[.!,;]|$)", re.IGNORECASE)
REMOVE_DIRECTIVE_RE = re.compile(r"\b(?:remove|drop|cut|avoid)\s+['\"]?([a-z0-9 _-]{2,80})['\"]?", re.IGNORECASE)
ADD_DIRECTIVE_RE = re.compile(r"\b(?:add|include|mention)\s+['\"]?([a-z0-9 _-]{2,80})['\"]?", re.IGNORECASE)
EMOJI_RE = re.compile(r"[\U00010000-\U0010FFFF]")
DENY_CONFIDENCE_THRESHOLD = 0.9


class ApiError(RuntimeError):
    def __init__(self, status_code: int, payload: Any) -> None:
        self.status_code = status_code
        self.payload = payload
        super().__init__(f"HTTP {status_code}")

    def code(self) -> str | None:
        if isinstance(self.payload, dict):
            detail = self.payload.get("detail")
            if isinstance(detail, dict):
                value = detail.get("code")
                if isinstance(value, str):
                    return value
        return None


@dataclass(frozen=True)
class Config:
    api_url: str
    tenant_id: str
    machine_key_id: str
    machine_secret: str
    agent_id: str
    api_key: str | None


@dataclass(frozen=True)
class QueueDecision:
    should_process: bool
    reason: str
    latest_feedback: dict[str, Any] | None
    latest_machine: dict[str, Any] | None


@dataclass(frozen=True)
class SoulSnapshot:
    version: int | None
    content: str


@dataclass(frozen=True)
class DenyAssessment:
    confidence: float
    reasons: tuple[str, ...]


@dataclass(frozen=True)
class ThreadIntent:
    tighten: bool
    expand: bool
    tone: str
    end_with: str
    replacements: tuple[tuple[str, str], ...]
    removals: tuple[str, ...]
    additions: tuple[str, ...]


def _parse_env_file(path: Path) -> dict[str, str]:
    values: dict[str, str] = {}
    if not path.exists():
        return values
    for raw_line in path.read_text(encoding="utf-8").splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("export "):
            line = line[len("export ") :]
        if "=" not in line:
            continue
        key, raw_value = line.split("=", 1)
        key = key.strip()
        value = raw_value.strip().strip("\"'")
        if key:
            values[key] = value
    return values


def _apply_env_defaults(path: Path, *, overwrite: bool = False) -> None:
    values = _parse_env_file(path)
    for key, value in values.items():
        if overwrite:
            os.environ[key] = value
        else:
            os.environ.setdefault(key, value)


def _load_agent_env(agent_id: str | None) -> None:
    cwd = Path.cwd()

    # Runtime fallback paths used by OpenClaw client boxes.
    runtime_env = (os.environ.get("LARRY_ENV_PATH") or "").strip()
    if runtime_env:
        _apply_env_defaults(Path(runtime_env), overwrite=True)

    state_dir = (os.environ.get("OPENCLAW_STATE_DIR") or "").strip()
    if state_dir:
        _apply_env_defaults(Path(state_dir) / ".env")

    # Agent-scoped runtime envs should win over inherited process env vars.
    if agent_id:
        _apply_env_defaults(Path(f"/home/openclaw/.openclaw/{agent_id}.env"), overwrite=True)
        _apply_env_defaults(Path(f"/agent/.openclaw/{agent_id}.env"), overwrite=True)
        _apply_env_defaults(Path(f"/workspace/.openclaw/{agent_id}.env"), overwrite=True)

    for fallback in (
        "/home/openclaw/.openclaw/larry.env",
        "/home/openclaw/.openclaw/.env",
        "/agent/.openclaw/larry.env",
        "/workspace/.openclaw/larry.env",
    ):
        _apply_env_defaults(Path(fallback))

    if agent_id:
        _apply_env_defaults(cwd / ".claude" / "agents" / f"{agent_id}.env", overwrite=True)
    current_agent = os.environ.get("OPENCLAW_AGENT_ID")
    if current_agent:
        _apply_env_defaults(Path(f"/home/openclaw/.openclaw/{current_agent}.env"), overwrite=True)
        _apply_env_defaults(Path(f"/agent/.openclaw/{current_agent}.env"), overwrite=True)
        _apply_env_defaults(Path(f"/workspace/.openclaw/{current_agent}.env"), overwrite=True)
        _apply_env_defaults(cwd / ".claude" / "agents" / f"{current_agent}.env", overwrite=True)
    _apply_env_defaults(cwd / "services" / "approval_feedback_api" / ".env")


def _require_env(name: str) -> str:
    value = (os.environ.get(name) or "").strip()
    if not value:
        raise SystemExit(f"Missing required environment variable: {name}")
    return value


def resolve_config(agent_override: str | None) -> Config:
    _load_agent_env(agent_override)

    agent_id = (agent_override or os.environ.get("OPENCLAW_AGENT_ID") or "").strip()
    if not agent_id:
        raise SystemExit("Missing agent id. Set OPENCLAW_AGENT_ID or pass --agent-id.")

    api_url = _require_env("OPENCLAW_API_URL").rstrip("/")
    tenant_id = _require_env("OPENCLAW_TENANT_ID")
    machine_key_id = _require_env("OPENCLAW_MACHINE_KEY_ID")
    machine_secret = _require_env("OPENCLAW_MACHINE_SECRET")
    api_key = (os.environ.get("OPENCLAW_API_KEY") or "").strip() or None

    return Config(
        api_url=api_url,
        tenant_id=tenant_id,
        machine_key_id=machine_key_id,
        machine_secret=machine_secret,
        agent_id=agent_id,
        api_key=api_key,
    )


def _auth_headers(config: Config, *, json_body: bool = False) -> dict[str, str]:
    headers = {
        "X-Tenant-Id": config.tenant_id,
        "X-Machine-Key-Id": config.machine_key_id,
        "X-Machine-Secret": config.machine_secret,
    }
    if config.api_key:
        headers["X-API-Key"] = config.api_key
    if json_body:
        headers["Content-Type"] = "application/json"
    return headers


def _resolve_ccurl_path() -> Path | None:
    candidates: list[str] = []
    explicit = (os.environ.get("OPENCLAW_CCURL") or "").strip()
    if explicit:
        candidates.append(explicit)

    state_dir = (os.environ.get("OPENCLAW_STATE_DIR") or "").strip()
    if state_dir:
        candidates.append(str(Path(state_dir) / "bin" / "ccurl"))

    candidates.extend(
        [
            "/home/openclaw/.openclaw/bin/ccurl",
            "/agent/.openclaw/bin/ccurl",
            "/workspace/.openclaw/bin/ccurl",
        ]
    )

    for raw in candidates:
        path = Path(raw)
        if path.is_file() and os.access(path, os.X_OK):
            return path
    return None


def _request_json_via_ccurl(
    ccurl_path: Path,
    config: Config,
    method: str,
    path: str,
    *,
    params: dict[str, Any] | None = None,
    body: dict[str, Any] | None = None,
) -> dict[str, Any]:
    query = urlencode({k: v for k, v in (params or {}).items() if v is not None})
    url = f"{config.api_url}{path}"
    if query:
        url = f"{url}?{query}"

    headers = _auth_headers(config, json_body=body is not None)
    cmd: list[str] = [
        str(ccurl_path),
        "-sS",
        "-w",
        "\nHTTP_STATUS:%{http_code}",
        "-X",
        method.upper(),
    ]
    for key, value in headers.items():
        cmd.extend(["-H", f"{key}: {value}"])
    if body is not None:
        payload = json.dumps(body, separators=(",", ":"), ensure_ascii=False)
        cmd.extend(["--data-binary", payload])
    cmd.append(url)

    try:
        completed = subprocess.run(
            cmd,
            capture_output=True,
            text=True,
            timeout=30,
            check=False,
        )
    except OSError as error:
        raise SystemExit(f"Failed to execute ccurl: {error}") from error
    except subprocess.TimeoutExpired as error:
        raise SystemExit("Connection failed: timed out while calling ccurl") from error

    stdout = completed.stdout or ""
    stderr = (completed.stderr or "").strip()

    marker = "\nHTTP_STATUS:"
    if marker in stdout:
        payload_text, status_text = stdout.rsplit(marker, 1)
        try:
            status = int(status_text.strip())
        except ValueError:
            status = 0
    else:
        payload_text = stdout
        status = 0

    payload_text = payload_text.strip()
    parsed: Any = {}
    if payload_text:
        try:
            parsed = json.loads(payload_text)
        except json.JSONDecodeError:
            parsed = {"detail": {"code": "HTTP_ERROR", "message": payload_text}}

    if completed.returncode != 0 and status == 0:
        detail = stderr or "ccurl failed without HTTP status"
        raise SystemExit(f"Connection failed: {detail}")

    if status >= 400:
        if not isinstance(parsed, dict):
            parsed = {"detail": {"code": "HTTP_ERROR", "message": payload_text or f"HTTP {status}"}}
        raise ApiError(status, parsed)

    if not payload_text:
        return {}
    if isinstance(parsed, dict):
        return parsed
    raise ApiError(status or 500, {"detail": {"code": "INVALID_JSON", "message": "Response is not an object."}})


def _request_json(
    config: Config,
    method: str,
    path: str,
    *,
    params: dict[str, Any] | None = None,
    body: dict[str, Any] | None = None,
) -> dict[str, Any]:
    ccurl_path = _resolve_ccurl_path()
    if ccurl_path is not None:
        return _request_json_via_ccurl(
            ccurl_path,
            config,
            method,
            path,
            params=params,
            body=body,
        )

    query = urlencode({k: v for k, v in (params or {}).items() if v is not None})
    url = f"{config.api_url}{path}"
    if query:
        url = f"{url}?{query}"

    payload = None
    headers = _auth_headers(config, json_body=body is not None)
    if body is not None:
        payload = json.dumps(body, separators=(",", ":")).encode("utf-8")

    req = Request(url=url, method=method.upper(), headers=headers, data=payload)
    try:
        with urlopen(req, timeout=30) as response:
            raw = response.read().decode("utf-8", errors="replace")
            if not raw.strip():
                return {}
            parsed = json.loads(raw)
            if isinstance(parsed, dict):
                return parsed
            raise ApiError(response.status, {"detail": {"code": "INVALID_JSON", "message": "Response is not an object."}})
    except HTTPError as error:
        raw = error.read().decode("utf-8", errors="replace") if error.fp else ""
        payload_obj: Any
        if raw.strip():
            try:
                payload_obj = json.loads(raw)
            except json.JSONDecodeError:
                payload_obj = {"detail": {"code": "HTTP_ERROR", "message": raw.strip()}}
        else:
            payload_obj = {"detail": {"code": "HTTP_ERROR", "message": f"HTTP {error.code}"}}
        raise ApiError(error.code, payload_obj) from error
    except URLError as error:
        raise SystemExit(f"Connection failed: {error}") from error


def _print_target(config: Config) -> None:
    print(f"target api_url={config.api_url} tenant_id={config.tenant_id} agent_id={config.agent_id}")


def _response_data(payload: dict[str, Any]) -> dict[str, Any]:
    data = payload.get("data")
    if isinstance(data, dict):
        return data
    return {}


def _parse_time(value: str | None) -> datetime:
    if not value:
        return datetime.fromtimestamp(0, tz=timezone.utc)
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return datetime.fromtimestamp(0, tz=timezone.utc)


def _sequence(value: Any) -> int:
    try:
        return int(value)
    except (TypeError, ValueError):
        return 0


def _message_key(message: dict[str, Any]) -> tuple[datetime, int]:
    return (_parse_time(message.get("created_at")), _sequence(message.get("sequence")))


def _latest_message(messages: list[dict[str, Any]], predicate: Any) -> dict[str, Any] | None:
    matches = [item for item in messages if predicate(item) and item.get("deleted_at") is None]
    if not matches:
        return None
    return max(matches, key=_message_key)


def _extract_soul_version_from_text(text: str | None) -> int | None:
    if not text:
        return None
    match = SOUL_VERSION_RE.search(text)
    if not match:
        return None
    try:
        return int(match.group(1))
    except ValueError:
        return None


def _latest_system_soul_update(messages: list[dict[str, Any]]) -> tuple[int | None, dict[str, Any] | None]:
    candidates: list[tuple[int, dict[str, Any]]] = []
    for message in messages:
        if message.get("message_type") != "system":
            continue
        content = message.get("content")
        if not isinstance(content, str):
            continue
        match = SOUL_UPDATED_RE.search(content)
        if not match:
            continue
        try:
            version = int(match.group(1))
        except ValueError:
            continue
        candidates.append((version, message))
    if not candidates:
        return None, None
    version, message = max(candidates, key=lambda item: _message_key(item[1]))
    return version, message


def _queue_decision(
    messages: list[dict[str, Any]],
    published_soul_version: int | None,
) -> QueueDecision:
    latest_feedback = _latest_message(
        messages,
        lambda item: item.get("author_type") != "machine" and item.get("message_type") in {"feedback", "comment"},
    )
    latest_machine = _latest_message(
        messages,
        lambda item: item.get("author_type") == "machine" and item.get("message_type") in {"edit_diff", "comment"},
    )

    drift_reason: str | None = None
    if published_soul_version is not None and latest_machine is not None:
        machine_key = _message_key(latest_machine)
        machine_soul_version = _extract_soul_version_from_text(latest_machine.get("content"))
        if machine_soul_version is not None and machine_soul_version < published_soul_version:
            drift_reason = "machine_soul_version_drift"
        else:
            system_version, system_message = _latest_system_soul_update(messages)
            if (
                system_version is not None
                and system_message is not None
                and system_version >= published_soul_version
                and _message_key(system_message) > machine_key
            ):
                drift_reason = "soul_update_newer_than_machine"

    if latest_feedback is None:
        if drift_reason is not None:
            return QueueDecision(True, drift_reason, None, latest_machine)
        return QueueDecision(False, "no_feedback", None, latest_machine)
    if latest_machine is None:
        return QueueDecision(True, "no_machine_response", latest_feedback, None)

    feedback_key = _message_key(latest_feedback)
    machine_key = _message_key(latest_machine)
    if feedback_key > machine_key:
        return QueueDecision(True, "feedback_newer_than_machine", latest_feedback, latest_machine)

    if drift_reason is not None:
        return QueueDecision(True, drift_reason, latest_feedback, latest_machine)

    return QueueDecision(False, "up_to_date", latest_feedback, latest_machine)


def _fetch_all_agent_revisions(config: Config, status: str, limit: int = 200) -> list[dict[str, Any]]:
    items: list[dict[str, Any]] = []
    cursor: str | None = None
    while True:
        payload = _request_json(
            config,
            "GET",
            f"/v0/agents/{config.agent_id}/revision-requests",
            params={"status": status, "limit": limit, "cursor": cursor},
        )
        data = _response_data(payload)
        page = data.get("items")
        if not isinstance(page, list):
            break
        items.extend([entry for entry in page if isinstance(entry, dict)])
        next_cursor = data.get("next_cursor")
        if not isinstance(next_cursor, str) or not next_cursor:
            break
        cursor = next_cursor
    return items


def _fetch_pending_approvals(config: Config, limit: int = 200) -> list[dict[str, Any]]:
    items: list[dict[str, Any]] = []
    cursor: str | None = None
    while True:
        payload = _request_json(
            config,
            "GET",
            "/v0/approval-requests",
            params={
                "status": "pending",
                "agent_id": config.agent_id,
                "limit": limit,
                "cursor": cursor,
            },
        )
        data = _response_data(payload)
        page = data.get("items")
        if not isinstance(page, list):
            break
        items.extend([entry for entry in page if isinstance(entry, dict)])
        next_cursor = data.get("next_cursor")
        if not isinstance(next_cursor, str) or not next_cursor:
            break
        cursor = next_cursor
    return items


def _fetch_messages(config: Config, approval_id: str, limit: int = 200) -> list[dict[str, Any]]:
    items: list[dict[str, Any]] = []
    cursor: str | None = None
    while True:
        payload = _request_json(
            config,
            "GET",
            f"/v0/approval-requests/{approval_id}/messages",
            params={"limit": limit, "cursor": cursor},
        )
        data = _response_data(payload)
        page = data.get("messages")
        if not isinstance(page, list):
            break
        items.extend([entry for entry in page if isinstance(entry, dict)])
        next_cursor = data.get("next_cursor")
        if not isinstance(next_cursor, str) or not next_cursor:
            break
        cursor = next_cursor
    return items


def _load_published_soul_snapshot(config: Config) -> SoulSnapshot:
    payload = _request_json(
        config,
        "GET",
        "/v0/integrations/claw-runtime/policies/soul_md",
        params={"agent_id": config.agent_id},
    )
    data = _response_data(payload)
    published = data.get("published")
    if not isinstance(published, dict):
        return SoulSnapshot(version=None, content="")
    version = published.get("version")
    content = _normalize_text(published.get("content"))
    try:
        return SoulSnapshot(version=int(version), content=content)
    except (TypeError, ValueError):
        return SoulSnapshot(version=None, content=content)


def _load_published_soul_version(config: Config) -> int | None:
    return _load_published_soul_snapshot(config).version


def _choose_revision_for_approval(revision_map: dict[str, list[dict[str, Any]]], approval_id: str) -> dict[str, Any] | None:
    revisions = revision_map.get(approval_id, [])
    if not revisions:
        return None

    def rank(item: dict[str, Any]) -> tuple[int, datetime, int]:
        status = str(item.get("status") or "")
        status_rank = 0
        if status in {"pending", "dispatched"}:
            status_rank = 2
        elif status == "expired":
            status_rank = 1
        return (status_rank, _parse_time(item.get("created_at")), _sequence(item.get("id")))

    candidates = [item for item in revisions if str(item.get("status") or "") in {"pending", "dispatched", "expired"}]
    if not candidates:
        return None
    return max(candidates, key=rank)


def _feedback_fingerprint(feedback: dict[str, Any] | None) -> str:
    if feedback is None:
        return "none"
    basis = json.dumps(
        {
            "id": feedback.get("id"),
            "created_at": feedback.get("created_at"),
            "sequence": feedback.get("sequence"),
            "content": feedback.get("content"),
        },
        sort_keys=True,
        separators=(",", ":"),
        ensure_ascii=True,
    )
    return hashlib.sha1(basis.encode("utf-8")).hexdigest()[:12]


def _normalize_text(value: Any) -> str:
    if isinstance(value, str):
        return value.strip()
    return ""


def _strip_revision_audit_markers(value: Any) -> str:
    normalized = _normalize_text(value)
    if not normalized:
        return ""
    without_reconciled = AUDIT_RECONCILED_SUFFIX_RE.sub("", normalized).strip()
    without_feedback = AUDIT_FEEDBACK_SUFFIX_RE.sub("", without_reconciled).strip()
    return without_feedback


def _normalize_for_compare(value: Any) -> str:
    cleaned = _strip_revision_audit_markers(value)
    if not cleaned:
        return ""
    return WHITESPACE_RE.sub(" ", cleaned).strip().lower()


def _semantic_compare_text(value: Any) -> str:
    normalized = _normalize_for_compare(value)
    if not normalized:
        return ""
    collapsed = re.sub(r"[^a-z0-9]+", " ", normalized)
    return WHITESPACE_RE.sub(" ", collapsed).strip()


def _extract_seed_text(approval_detail: dict[str, Any]) -> str:
    context = approval_detail.get("context")
    payload = context.get("payload") if isinstance(context, dict) else None
    if not isinstance(payload, dict):
        return ""

    proposed_reply = _strip_revision_audit_markers(payload.get("proposed_reply"))
    if proposed_reply:
        return proposed_reply
    return _strip_revision_audit_markers(payload.get("summary"))


def _extract_context_type(approval_detail: dict[str, Any]) -> str:
    context = approval_detail.get("context")
    if not isinstance(context, dict):
        return ""
    return _normalize_text(context.get("context_type")).lower()


def _split_sentences(text: str) -> list[str]:
    cleaned = WHITESPACE_RE.sub(" ", text).strip()
    if not cleaned:
        return []
    parts = [part.strip() for part in SENTENCE_SPLIT_RE.split(cleaned) if part.strip()]
    return parts or [cleaned]


def _has_tighten_intent(feedback_text: str) -> bool:
    lowered = feedback_text.lower()
    return any(keyword in lowered for keyword in TIGHTEN_KEYWORDS)


def _extract_end_with_directive(feedback_text: str) -> str:
    compact = WHITESPACE_RE.sub(" ", feedback_text).strip()
    if not compact:
        return ""
    match = END_WITH_RE.search(compact)
    if not match:
        return ""
    directive = match.group(1).strip().strip("`\"'")
    if not directive:
        return ""
    return directive[:280]


def _append_sentence(base: str, addition: str) -> str:
    base_clean = base.strip()
    addition_clean = addition.strip()
    if not addition_clean:
        return base_clean
    if not base_clean:
        return addition_clean
    if _normalize_for_compare(addition_clean) in _normalize_for_compare(base_clean):
        return base_clean
    if base_clean[-1] not in ".!?":
        base_clean = f"{base_clean}."
    return f"{base_clean} {addition_clean}".strip()


def _strip_lead_in_clause(sentence: str) -> str:
    compact = WHITESPACE_RE.sub(" ", sentence).strip()
    if ":" not in compact:
        return compact
    prefix, suffix = compact.split(":", 1)
    if len(prefix.split()) <= 12 and len(suffix.split()) >= 4:
        return suffix.strip()
    return compact


def _to_sentence_case(text: str) -> str:
    value = text.strip()
    if not value:
        return ""
    first = value[0].upper() if value[0].isalpha() else value[0]
    return f"{first}{value[1:]}"


def _to_lower_lead(text: str) -> str:
    value = text.strip()
    if not value:
        return ""
    first = value[0].lower() if value[0].isalpha() else value[0]
    return f"{first}{value[1:]}"


def _force_material_rewrite(seed_text: str, feedback_text: str) -> str:
    edited = seed_text.strip()
    if not edited:
        return ""

    if _has_tighten_intent(feedback_text):
        sentences = _split_sentences(edited)
        if len(sentences) >= 3:
            edited = " ".join(sentences[:2])
        elif len(sentences) == 2:
            edited = sentences[0]

    tone_hint = _detect_tone_hint(feedback_text)
    if tone_hint:
        edited = _apply_tone_style(edited, tone_hint)

    if _is_noop_edit(edited, seed_text):
        sentences = _split_sentences(seed_text)
        cleaned_sentences = [
            _strip_lead_in_clause(item).rstrip(".!?").strip()
            for item in sentences
            if _strip_lead_in_clause(item).strip()
        ]
        if cleaned_sentences:
            lead = _to_sentence_case(cleaned_sentences[0])
            rest = ". ".join(item.strip().rstrip(".!?") for item in cleaned_sentences[1:] if item.strip()).strip()
            if rest:
                edited = f"{lead}. In practice, {_to_lower_lead(rest)}."
            else:
                edited = f"In practice, {_to_lower_lead(lead)}."

    if _is_noop_edit(edited, seed_text):
        compact_seed = _strip_lead_in_clause(seed_text).strip().rstrip(".!?")
        if compact_seed:
            edited = f"Core point: {_to_sentence_case(compact_seed)}."

    cta = _extract_end_with_directive(feedback_text)
    if cta:
        edited = _append_sentence(edited, cta)

    return edited[:1900]


def _is_noop_edit(edited_content: str, baseline: str) -> bool:
    normalized_baseline = _semantic_compare_text(baseline)
    if not normalized_baseline:
        return False
    return _semantic_compare_text(edited_content) == normalized_baseline


def _ordered_messages(messages: list[dict[str, Any]]) -> list[dict[str, Any]]:
    ordered = [item for item in messages if isinstance(item, dict) and item.get("deleted_at") is None]
    ordered.sort(key=_message_key)
    return ordered


def _revision_key(revision: dict[str, Any]) -> tuple[datetime, int]:
    return (_parse_time(revision.get("created_at")), _sequence(revision.get("id")))


def _normalize_trigger_ids(value: Any) -> list[str]:
    if not isinstance(value, list):
        return []
    trigger_ids: list[str] = []
    for item in value:
        normalized = str(item or "").strip()
        if normalized and normalized not in trigger_ids:
            trigger_ids.append(normalized)
    return trigger_ids


def _message_context(message: dict[str, Any]) -> dict[str, Any]:
    # Keep full text so downstream rewrite logic never operates on truncated drafts.
    content = _strip_revision_audit_markers(message.get("content"))
    edited_content = _strip_revision_audit_markers(message.get("edited_content"))
    return {
        "id": str(message.get("id") or ""),
        "created_at": message.get("created_at"),
        "sequence": _sequence(message.get("sequence")),
        "author_type": _normalize_text(message.get("author_type")),
        "message_type": _normalize_text(message.get("message_type")),
        "content": content,
        "edited_content": edited_content,
    }


def _latest_prior_edit_text(prior_machine_messages: list[dict[str, Any]]) -> str:
    for message in reversed(prior_machine_messages):
        if message.get("message_type") == "edit_diff":
            edited = _normalize_text(message.get("edited_content"))
            if edited:
                return edited
            content = _normalize_text(message.get("content"))
            if content:
                return content
    return ""


def _count_policy_risk_revisions(revision_outcomes: list[dict[str, Any]]) -> int:
    count = 0
    for outcome in revision_outcomes:
        terminal_reason = _normalize_text(outcome.get("terminal_reason"))
        if terminal_reason and POLICY_RISK_RE.search(terminal_reason):
            count += 1
    return count


def _build_revision_context(
    approval_id: str,
    approval_detail: dict[str, Any],
    *,
    messages: list[dict[str, Any]],
    revision: dict[str, Any] | None,
    revision_history: list[dict[str, Any]] | None,
    soul_snapshot: SoulSnapshot,
) -> dict[str, Any]:
    ordered_messages = _ordered_messages(messages)
    latest_feedback = _latest_message(ordered_messages, lambda item: item.get("message_type") == "feedback")
    seed_text = _extract_seed_text(approval_detail)

    ordered_revisions = [item for item in (revision_history or []) if isinstance(item, dict)]
    ordered_revisions.sort(key=_revision_key)
    current_revision_id = str((revision or {}).get("id") or "")

    revision_outcomes: list[dict[str, Any]] = []
    for item in ordered_revisions:
        revision_outcomes.append(
            {
                "id": str(item.get("id") or ""),
                "status": _normalize_text(item.get("status")),
                "created_at": item.get("created_at"),
                "updated_at": item.get("updated_at"),
                "terminal_reason": _normalize_text(item.get("terminal_reason")),
                "fulfilled_message_id": str(item.get("fulfilled_message_id") or ""),
                "trigger_message_ids": _normalize_trigger_ids(item.get("trigger_message_ids")),
                "is_current": str(item.get("id") or "") == current_revision_id,
            }
        )

    thread_messages = [_message_context(item) for item in ordered_messages]
    prior_machine_messages = [
        _message_context(item)
        for item in ordered_messages
        if item.get("author_type") == "machine" and item.get("message_type") in {"edit_diff", "comment"}
    ]
    feedback_history = [
        item
        for item in thread_messages
        if item.get("author_type") != "machine" and item.get("message_type") in {"feedback", "comment"}
    ]

    return {
        "approval_id": approval_id,
        "context_type": _extract_context_type(approval_detail),
        "seed_text": seed_text,
        "latest_feedback": latest_feedback,
        "latest_feedback_text": _strip_revision_audit_markers((latest_feedback or {}).get("content")),
        "thread_messages": thread_messages,
        "trigger_message_ids": _normalize_trigger_ids((revision or {}).get("trigger_message_ids")),
        "prior_machine_messages": prior_machine_messages,
        "feedback_history": feedback_history,
        "latest_prior_edit_text": _latest_prior_edit_text(prior_machine_messages),
        "revision_outcomes": revision_outcomes,
        "policy_risk_revision_count": _count_policy_risk_revisions(revision_outcomes),
        "soul_version": soul_snapshot.version,
        "soul_text": soul_snapshot.content,
    }


def _has_actionable_guidance(feedback_text: str) -> bool:
    compact = WHITESPACE_RE.sub(" ", feedback_text).strip()
    if not compact:
        return False
    if _extract_end_with_directive(compact):
        return True
    lowered = compact.lower()
    if any(keyword in lowered for keyword in ACTIONABLE_KEYWORDS):
        return True
    if SOUL_UPDATE_HINT_RE.search(compact):
        return True
    if _detect_tone_hint(compact):
        return True
    if ":" in compact and len(compact.split()) >= 6:
        return True
    return False


def _feedback_text_history(context: dict[str, Any]) -> list[str]:
    history = context.get("feedback_history")
    if not isinstance(history, list):
        return []
    items: list[str] = []
    for entry in history:
        if not isinstance(entry, dict):
            continue
        content = _normalize_text(entry.get("content"))
        if content:
            items.append(content)
    return items


def _detect_tone_hint(feedback_text: str) -> str:
    lowered = feedback_text.lower()
    for tone, hints in TONE_HINTS.items():
        for hint in hints:
            if hint in lowered:
                return tone
    return ""


def _extract_replacements(feedback_text: str) -> list[tuple[str, str]]:
    replacements: list[tuple[str, str]] = []
    for before, after in REPLACE_DIRECTIVE_RE.findall(feedback_text):
        src = _normalize_text(before).strip("`\"'")
        dst = _normalize_text(after).strip("`\"'")
        if src and dst and (src, dst) not in replacements:
            replacements.append((src, dst))
    return replacements[:3]


def _extract_removals(feedback_text: str) -> list[str]:
    removals: list[str] = []
    for value in REMOVE_DIRECTIVE_RE.findall(feedback_text):
        item = _normalize_text(value).strip("`\"'")
        item = re.split(r"\b(?:and|but|replace|with|end)\b", item, maxsplit=1, flags=re.IGNORECASE)[0].strip()
        if not item:
            continue
        if item in {"this", "that", "it"}:
            continue
        if item not in removals:
            removals.append(item)
    return removals[:4]


def _extract_additions(feedback_text: str) -> list[str]:
    additions: list[str] = []
    for value in ADD_DIRECTIVE_RE.findall(feedback_text):
        item = _normalize_text(value).strip("`\"'")
        item = re.split(r"\b(?:and|but|then|while)\b", item, maxsplit=1, flags=re.IGNORECASE)[0].strip()
        if not item:
            continue
        if item in {"this", "that", "it"}:
            continue
        if item not in additions:
            additions.append(item)
    return additions[:4]


def _synthesize_thread_intent(context: dict[str, Any]) -> ThreadIntent:
    feedback_history = _feedback_text_history(context)
    effective_feedback = _effective_feedback_text(context)

    tighten = False
    expand = False
    tone = ""
    end_with = ""
    replacements: list[tuple[str, str]] = []
    removals: list[str] = []
    additions: list[str] = []

    for feedback_text in feedback_history:
        lowered = feedback_text.lower()
        if _has_tighten_intent(feedback_text):
            tighten = True
            expand = False
        if any(keyword in lowered for keyword in EXPAND_KEYWORDS):
            expand = True
            tighten = False

        tone_hint = _detect_tone_hint(feedback_text)
        if tone_hint:
            tone = tone_hint

        directive = _extract_end_with_directive(feedback_text)
        if directive:
            end_with = directive

        for pair in _extract_replacements(feedback_text):
            if pair not in replacements:
                replacements.append(pair)
        for item in _extract_removals(feedback_text):
            if item not in removals:
                removals.append(item)
        for item in _extract_additions(feedback_text):
            if item not in additions:
                additions.append(item)

    # Ensure latest-turn instruction always wins for final CTA/length decisions.
    if effective_feedback:
        lowered = effective_feedback.lower()
        if _has_tighten_intent(effective_feedback):
            tighten = True
            expand = False
        if any(keyword in lowered for keyword in EXPAND_KEYWORDS):
            expand = True
            tighten = False

        latest_tone = _detect_tone_hint(effective_feedback)
        if latest_tone:
            tone = latest_tone
        latest_end = _extract_end_with_directive(effective_feedback)
        if latest_end:
            end_with = latest_end

    return ThreadIntent(
        tighten=tighten,
        expand=expand,
        tone=tone,
        end_with=end_with,
        replacements=tuple(replacements[:5]),
        removals=tuple(removals[:6]),
        additions=tuple(additions[:6]),
    )


def _effective_feedback_text(context: dict[str, Any]) -> str:
    latest_feedback = _normalize_text(context.get("latest_feedback_text"))
    if latest_feedback:
        return latest_feedback

    trigger_ids_raw = context.get("trigger_message_ids")
    if isinstance(trigger_ids_raw, list) and trigger_ids_raw:
        trigger_ids = {str(item).strip() for item in trigger_ids_raw if str(item).strip()}
        history = context.get("feedback_history")
        if isinstance(history, list):
            for entry in reversed(history):
                if not isinstance(entry, dict):
                    continue
                message_id = str(entry.get("id") or "").strip()
                if message_id and message_id in trigger_ids:
                    content = _normalize_text(entry.get("content"))
                    if content:
                        return content
    return ""


def _needs_clarification(context: dict[str, Any]) -> bool:
    seed_text = _normalize_text(context.get("seed_text"))
    prior_edit_text = _normalize_text(context.get("latest_prior_edit_text"))
    feedback_text = _effective_feedback_text(context)
    context_type = _normalize_text(context.get("context_type")).lower()
    feedback_history = _feedback_text_history(context)
    prior_feedback = feedback_history[:-1] if feedback_history else []

    if not seed_text and not prior_edit_text:
        return True
    if not feedback_text:
        return False

    if context_type == "social_reply":
        # For social replies, treat any non-empty human feedback as directional
        # and always produce a copy/paste-ready rewrite when source text exists.
        return False

    if _has_actionable_guidance(feedback_text):
        return False

    compact = WHITESPACE_RE.sub(" ", feedback_text).strip()
    if not compact:
        return True
    if AMBIGUOUS_FEEDBACK_RE.search(compact):
        return True
    if any(_has_actionable_guidance(item) for item in prior_feedback):
        if len(compact) <= 12:
            return True
        if compact in {"ok", "k", "sure", "fine"}:
            return True
        return False
    if len(compact) <= 20:
        return True
    if len(compact.split()) <= 4:
        return True
    return False


def _assess_deny_confidence(context: dict[str, Any]) -> DenyAssessment:
    feedback_text = _effective_feedback_text(context)
    if not feedback_text:
        return DenyAssessment(confidence=0.0, reasons=())

    score = 0.0
    reasons: list[str] = []
    if DENY_NEGATION_RE.search(feedback_text):
        score -= 0.6
        reasons.append("deny_negated")
    if SAFETY_NEGATION_RE.search(feedback_text):
        score -= 0.25
        reasons.append("risk_negated")

    lowered = feedback_text.lower()
    has_deny_directive = DENY_DIRECTIVE_RE.search(feedback_text) is not None
    risk_terms = POLICY_RISK_RE.findall(feedback_text)
    has_policy_risk = bool(risk_terms)
    has_policy_violation = POLICY_VIOLATION_RE.search(feedback_text) is not None
    explicit_risk_statement = RISK_STATEMENT_RE.search(feedback_text) is not None

    if has_deny_directive:
        score += 0.45
        reasons.append("deny_directive")
    if has_policy_risk:
        score += 0.35
        reasons.append("risk_terms")
        if len(risk_terms) >= 2:
            score += 0.1
            reasons.append("multiple_risk_terms")
    if has_policy_violation:
        score += 0.2
        reasons.append("policy_violation")
    if explicit_risk_statement:
        score += 0.15
        reasons.append("explicit_risk_statement")

    feedback_history = _feedback_text_history(context)
    prior_history = feedback_history[:-1] if feedback_history else []
    prior_risk_hits = sum(1 for item in prior_history if POLICY_RISK_RE.search(item) or POLICY_VIOLATION_RE.search(item))
    if prior_risk_hits >= 1:
        score += 0.1
        reasons.append("prior_feedback_risk_signal")
    if prior_risk_hits >= 2:
        score += 0.05
        reasons.append("repeated_feedback_risk")

    policy_risk_revision_count = int(context.get("policy_risk_revision_count") or 0)
    if policy_risk_revision_count >= 1:
        score += 0.1
        reasons.append("prior_revision_policy_risk")

    if "safe" in lowered and "unsafe" not in lowered:
        score -= 0.1
        reasons.append("safe_language")

    normalized = max(0.0, min(1.0, score))
    return DenyAssessment(confidence=normalized, reasons=tuple(reasons))


def _should_recommend_deny(context: dict[str, Any]) -> bool:
    assessment = _assess_deny_confidence(context)
    context["deny_assessment"] = {"confidence": assessment.confidence, "reasons": list(assessment.reasons)}
    return assessment.confidence >= DENY_CONFIDENCE_THRESHOLD


def _apply_replacements(text: str, replacements: tuple[tuple[str, str], ...]) -> str:
    edited = text
    for before, after in replacements:
        if not before or not after:
            continue
        pattern = re.compile(re.escape(before), re.IGNORECASE)
        edited = pattern.sub(after, edited)
    return edited


def _apply_removals(text: str, removals: tuple[str, ...]) -> str:
    edited = text
    for item in removals:
        if not item:
            continue
        pattern = re.compile(re.escape(item), re.IGNORECASE)
        edited = pattern.sub("", edited)
    edited = re.sub(r"\s{2,}", " ", edited)
    edited = re.sub(r"\s+([,.;:!?])", r"\1", edited)
    return edited.strip()


def _apply_additions(text: str, additions: tuple[str, ...]) -> str:
    edited = text
    for item in additions:
        if not item:
            continue
        if _normalize_for_compare(item) in _normalize_for_compare(edited):
            continue
        edited = _append_sentence(edited, item)
    return edited


def _apply_tone_style(text: str, tone: str) -> str:
    edited = text.strip()
    if not edited or not tone:
        return edited

    if tone in {"direct", "professional"}:
        for hedge in ("I think ", "Honestly, ", "honestly, ", "Maybe ", "maybe "):
            edited = edited.replace(hedge, "")
    if tone in {"formal", "professional"}:
        edited = edited.replace("don't", "do not").replace("can't", "cannot").replace("it's", "it is")
    if tone == "casual":
        edited = edited.replace("do not", "don't").replace("cannot", "can't").replace("it is", "it's")
    if tone == "deadpan" and not edited.lower().startswith("deadpan take:"):
        edited = f"Deadpan take: {edited}"
    if tone == "playful" and not edited.lower().startswith("Quick take:"):
        edited = f"Quick take: {edited}"
    return WHITESPACE_RE.sub(" ", edited).strip()


def _apply_soul_constraints(text: str, soul_text: str) -> str:
    edited = text.strip()
    if not edited:
        return ""
    if not soul_text:
        return edited

    if SOUL_NO_EMOJI_RE.search(soul_text):
        edited = EMOJI_RE.sub("", edited).strip()

    if SOUL_NO_HASHTAG_RE.search(soul_text):
        edited = re.sub(r"(?:^|\s)#[A-Za-z0-9_]+\b", " ", edited).strip()

    if SOUL_NO_EXCLAIM_RE.search(soul_text):
        edited = edited.replace("!", ".")
        edited = re.sub(r"\.{2,}", ".", edited)

    if SOUL_SINGLE_SENTENCE_RE.search(soul_text):
        sentences = _split_sentences(edited)
        if sentences:
            edited = sentences[0]

    return WHITESPACE_RE.sub(" ", edited).strip()


def _build_edit_content(context: dict[str, Any]) -> str:
    seed_text = _normalize_text(context.get("seed_text"))
    prior_edit_text = _normalize_text(context.get("latest_prior_edit_text"))
    feedback_text = _effective_feedback_text(context)
    feedback_history = _feedback_text_history(context)
    soul_text = _normalize_text(context.get("soul_text"))
    if not seed_text and not prior_edit_text:
        return ""

    intent = _synthesize_thread_intent(context)
    edited = prior_edit_text or seed_text
    tighten_votes = sum(1 for item in feedback_history if _has_tighten_intent(item))
    should_tighten = intent.tighten or (tighten_votes >= 2 and not intent.expand)
    if intent.expand:
        should_tighten = False
    if should_tighten:
        sentences = _split_sentences(edited)
        if len(sentences) >= 3:
            edited = " ".join(sentences[:2])
        elif len(sentences) == 2:
            edited = sentences[0]

    edited = _apply_replacements(edited, intent.replacements)
    edited = _apply_removals(edited, intent.removals)
    edited = _apply_additions(edited, intent.additions)
    edited = _apply_tone_style(edited, intent.tone)

    if intent.end_with:
        edited = _append_sentence(edited, intent.end_with)
    else:
        # Preserve direct latest directive when intent parser misses syntax variants.
        cta = _extract_end_with_directive(feedback_text)
        if cta:
            edited = _append_sentence(edited, cta)

    edited = _apply_soul_constraints(edited, soul_text)
    return _strip_revision_audit_markers(edited)[:1900]


def _build_clarification_comment(context: dict[str, Any]) -> str:
    soul_version = context.get("soul_version")
    prefix = f"Need clarification under soul v{soul_version}." if isinstance(soul_version, int) else "Need clarification."
    return (
        f"{prefix} Please share one concrete edit target (tone, length, or exact ending) so I can publish a revised draft."
    )[:380]


def _build_deny_recommendation_comment(context: dict[str, Any]) -> str:
    soul_version = context.get("soul_version")
    assessment = context.get("deny_assessment")
    confidence = 0.0
    if isinstance(assessment, dict):
        try:
            confidence = float(assessment.get("confidence") or 0.0)
        except (TypeError, ValueError):
            confidence = 0.0

    confidence_text = f" (confidence {confidence:.2f})" if confidence > 0 else ""
    if isinstance(soul_version, int):
        return (
            f"Recommend deny under soul v{soul_version}{confidence_text}: "
            "latest feedback indicates a policy/safety conflict."
        )[:380]
    return f"Recommend deny{confidence_text}: latest feedback indicates a policy/safety conflict."[:380]


def _build_fulfillment_payload(
    approval_id: str,
    revision_id: str,
    expected_version: int,
    latest_feedback: dict[str, Any] | None,
    approval_detail: dict[str, Any],
    soul_version: int | None,
    *,
    soul_text: str = "",
    messages: list[dict[str, Any]] | None = None,
    revision: dict[str, Any] | None = None,
    revision_history: list[dict[str, Any]] | None = None,
) -> tuple[dict[str, Any], str, str]:
    soul_snapshot = SoulSnapshot(version=soul_version, content=_normalize_text(soul_text))
    context_bundle = _build_revision_context(
        approval_id,
        approval_detail,
        messages=messages or [],
        revision=revision,
        revision_history=revision_history,
        soul_snapshot=soul_snapshot,
    )
    if context_bundle.get("latest_feedback") is None and latest_feedback is not None:
        context_bundle["latest_feedback"] = latest_feedback
        context_bundle["latest_feedback_text"] = _strip_revision_audit_markers(latest_feedback.get("content"))

    feedback_hash = _feedback_fingerprint(context_bundle.get("latest_feedback"))
    soul_marker = soul_snapshot.version if soul_snapshot.version is not None else 0

    action_kind = "edit_diff"
    if _should_recommend_deny(context_bundle):
        action_kind = "deny_recommendation"
    elif _needs_clarification(context_bundle):
        action_kind = "clarification"

    if action_kind == "deny_recommendation":
        content = _build_deny_recommendation_comment(context_bundle)
        message_type = "comment"
    elif action_kind == "clarification":
        content = _build_clarification_comment(context_bundle)
        message_type = "comment"
    else:
        baseline = _normalize_text(context_bundle.get("seed_text"))
        edited_content = _build_edit_content(context_bundle)
        if _is_noop_edit(edited_content, baseline):
            feedback_text = _normalize_text(context_bundle.get("latest_feedback_text"))
            edited_content = _force_material_rewrite(baseline or edited_content, feedback_text)
            edited_content = _apply_soul_constraints(edited_content, _normalize_text(context_bundle.get("soul_text")))
            edited_content = _strip_revision_audit_markers(edited_content)[:1900]

        if not edited_content:
            fallback_feedback = _normalize_text(context_bundle.get("latest_feedback_text"))
            edited_content = _strip_revision_audit_markers(fallback_feedback or baseline)[:1900]

        if _is_noop_edit(edited_content, baseline):
            feedback_text = _normalize_text(context_bundle.get("latest_feedback_text"))
            edited_content = _force_material_rewrite(baseline or edited_content, feedback_text or "rewrite tighter")
            edited_content = _apply_soul_constraints(edited_content, _normalize_text(context_bundle.get("soul_text")))
            edited_content = _strip_revision_audit_markers(edited_content)[:1900]

        content = (
            f"Revised draft under soul v{soul_marker}."
            if soul_snapshot.version is not None
            else "Revised draft after latest feedback."
        )
        message_type = "edit_diff"

    if message_type == "edit_diff":
        action_kind = "edit_diff"
    elif action_kind != "deny_recommendation":
        action_kind = "clarification"

    # Build deterministic idempotency key from the final payload shape.
    key_basis = {
        "approval_id": approval_id,
        "revision_id": revision_id,
        "action_kind": action_kind,
        "message_type": message_type,
        "feedback_hash": feedback_hash,
        "soul_version": soul_snapshot.version,
        "content": content,
    }
    if message_type == "edit_diff":
        key_basis["edited_content"] = edited_content
    key_digest = hashlib.sha1(json.dumps(key_basis, sort_keys=True, separators=(",", ":")).encode("utf-8")).hexdigest()[:16]
    idempotency_key = f"reconcile:{approval_id}:{revision_id}:s{soul_marker}:{key_digest}"[:128]

    payload: dict[str, Any] = {
        "content": content,
        "message_type": message_type,
        "revision_request_id": revision_id,
        "expected_version": expected_version,
        "idempotency_key": idempotency_key,
    }
    if message_type == "edit_diff":
        payload["edited_content"] = edited_content

    return payload, message_type, action_kind


def cmd_smoke(args: argparse.Namespace) -> int:
    config = resolve_config(args.agent_id)
    _print_target(config)
    payload = _request_json(
        config,
        "GET",
        f"/v0/agents/{config.agent_id}/revision-requests",
        params={"status": "pending", "limit": 1},
    )
    data = _response_data(payload)
    print(json.dumps({"status": "ok", "pending_preview": len(data.get("items", [])), "next_cursor": data.get("next_cursor")}, indent=2))
    return 0


def cmd_list(args: argparse.Namespace) -> int:
    config = resolve_config(args.agent_id)
    _print_target(config)

    if args.all:
        items = _fetch_all_agent_revisions(config, args.status, limit=args.limit)
        print(json.dumps({"items": items, "count": len(items)}, indent=2))
        return 0

    payload = _request_json(
        config,
        "GET",
        f"/v0/agents/{config.agent_id}/revision-requests",
        params={"status": args.status, "limit": args.limit},
    )
    data = _response_data(payload)
    print(json.dumps(data, indent=2))
    return 0


def cmd_fulfill(args: argparse.Namespace) -> int:
    config = resolve_config(args.agent_id)
    _print_target(config)

    input_path = Path(args.input)
    if not input_path.exists():
        raise SystemExit(f"Input file not found: {input_path}")

    with input_path.open("r", encoding="utf-8") as handle:
        body = json.load(handle)

    if not isinstance(body, dict):
        raise SystemExit("Input payload must be a JSON object.")

    body = dict(body)
    body.setdefault("revision_request_id", args.revision_id)
    body.setdefault("message_type", body.get("message_type", "edit_diff"))

    if "expected_version" not in body:
        detail = _request_json(config, "GET", f"/v0/approval-requests/{args.approval_id}")
        detail_data = _response_data(detail)
        body["expected_version"] = int(detail_data.get("version", 0))

    if "idempotency_key" not in body:
        digest = hashlib.sha1(json.dumps(body, sort_keys=True, separators=(",", ":")).encode("utf-8")).hexdigest()[:16]
        body["idempotency_key"] = f"manual:{args.approval_id}:{args.revision_id}:{digest}"[:128]

    response = _request_json(
        config,
        "POST",
        f"/v0/approval-requests/{args.approval_id}/messages/fulfill",
        body=body,
    )
    print(json.dumps(_response_data(response), indent=2))
    return 0


def cmd_reconcile(args: argparse.Namespace) -> int:
    config = resolve_config(args.agent_id)
    _print_target(config)

    soul_snapshot = SoulSnapshot(version=None, content="")
    try:
        soul_snapshot = _load_published_soul_snapshot(config)
    except ApiError as error:
        if error.status_code in {403, 404}:
            soul_snapshot = SoulSnapshot(version=None, content="")
        else:
            raise

    pending_approvals = _fetch_pending_approvals(config)

    revision_map: dict[str, list[dict[str, Any]]] = {}
    for status in ("pending", "dispatched", "expired", "fulfilled", "failed"):
        for revision in _fetch_all_agent_revisions(config, status):
            approval_id = str(revision.get("approval_id") or "")
            if not approval_id:
                continue
            revision_map.setdefault(approval_id, []).append(revision)

    summary = {
        "fulfilled": 0,
        "clarification_comments": 0,
        "deny_recommended": 0,
        "skipped": 0,
        "failed": 0,
        "processed": 0,
        "queued": 0,
        "remaining_pending": 0,
    }
    decisions: list[dict[str, Any]] = []

    for approval in pending_approvals:
        approval_id = str(approval.get("id") or "")
        if not approval_id:
            continue

        try:
            messages = _fetch_messages(config, approval_id)
        except ApiError as error:
            summary["failed"] += 1
            decisions.append(
                {
                    "approval_id": approval_id,
                    "reason": "message_fetch_failed",
                    "action": f"failed_{(error.code() or 'http_error').lower()}",
                }
            )
            continue
        decision = _queue_decision(messages, soul_snapshot.version)
        if not decision.should_process:
            continue

        summary["queued"] += 1
        entry = {
            "approval_id": approval_id,
            "reason": decision.reason,
            "action": "",
        }

        revision = _choose_revision_for_approval(revision_map, approval_id)
        if revision is None:
            summary["skipped"] += 1
            entry["action"] = "blocked_no_revision"
            decisions.append(entry)
            continue

        revision_id = str(revision.get("id") or "")
        if not revision_id:
            summary["skipped"] += 1
            entry["action"] = "blocked_bad_revision"
            decisions.append(entry)
            continue

        try:
            detail_payload = _request_json(config, "GET", f"/v0/approval-requests/{approval_id}")
        except ApiError as error:
            summary["failed"] += 1
            entry["action"] = f"failed_{(error.code() or 'http_error').lower()}"
            decisions.append(entry)
            continue

        detail = _response_data(detail_payload)
        status = str(detail.get("status") or "")
        if status in {"approved", "denied"}:
            summary["skipped"] += 1
            entry["action"] = "skip_resolved"
            decisions.append(entry)
            continue

        try:
            expected_version = int(detail.get("version"))
        except (TypeError, ValueError):
            summary["failed"] += 1
            entry["action"] = "failed_invalid_version"
            decisions.append(entry)
            continue

        payload, mode, action_kind = _build_fulfillment_payload(
            approval_id=approval_id,
            revision_id=revision_id,
            expected_version=expected_version,
            latest_feedback=decision.latest_feedback,
            approval_detail=detail,
            soul_version=soul_snapshot.version,
            soul_text=soul_snapshot.content,
            messages=messages,
            revision=revision,
            revision_history=revision_map.get(approval_id, []),
        )

        if args.dry_run:
            summary["processed"] += 1
            if action_kind == "deny_recommendation":
                summary["deny_recommended"] += 1
            elif mode == "comment":
                summary["clarification_comments"] += 1
            else:
                summary["fulfilled"] += 1
            entry["action"] = "dry_run"
            entry["message_type"] = mode
            entry["action_kind"] = action_kind
            entry["idempotency_key"] = payload["idempotency_key"]
            decisions.append(entry)
            continue

        try:
            _request_json(
                config,
                "POST",
                f"/v0/approval-requests/{approval_id}/messages/fulfill",
                body=payload,
            )
            summary["processed"] += 1
            if action_kind == "deny_recommendation":
                summary["deny_recommended"] += 1
            elif mode == "comment":
                summary["clarification_comments"] += 1
            else:
                summary["fulfilled"] += 1
            entry["action"] = "fulfilled"
            entry["message_type"] = mode
            entry["action_kind"] = action_kind
            decisions.append(entry)
        except ApiError as error:
            code = error.code() or "HTTP_ERROR"
            if error.status_code == 409 and code in {
                "APPROVAL_ALREADY_RESOLVED",
                "REVISION_REQUEST_STALE",
                "REVISION_REQUEST_EXPIRED",
                "VERSION_CONFLICT",
            }:
                summary["skipped"] += 1
                entry["action"] = f"skip_{code.lower()}"
            else:
                summary["failed"] += 1
                entry["action"] = f"failed_{code.lower()}"
            decisions.append(entry)

    remaining = _fetch_all_agent_revisions(config, "pending", limit=200)
    summary["remaining_pending"] = len(remaining)

    print(json.dumps({"soul_version": soul_snapshot.version, "summary": summary, "decisions": decisions}, indent=2))
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="OpenClaw revision wrapper")
    subparsers = parser.add_subparsers(dest="command", required=True)

    smoke = subparsers.add_parser("smoke", help="Validate auth and queue access")
    smoke.add_argument("--agent-id", default=None)
    smoke.set_defaults(func=cmd_smoke)

    list_cmd = subparsers.add_parser("list", help="List agent revision requests")
    list_cmd.add_argument("--agent-id", default=None)
    list_cmd.add_argument("--status", default="pending")
    list_cmd.add_argument("--limit", type=int, default=50)
    list_cmd.add_argument("--all", action="store_true")
    list_cmd.set_defaults(func=cmd_list)

    fulfill = subparsers.add_parser("fulfill", help="Fulfill one revision request")
    fulfill.add_argument("--agent-id", default=None)
    fulfill.add_argument("--approval-id", required=True)
    fulfill.add_argument("--revision-id", required=True)
    fulfill.add_argument("--input", required=True)
    fulfill.set_defaults(func=cmd_fulfill)

    reconcile = subparsers.add_parser("reconcile", help="Reconcile pending approvals requiring machine follow-up")
    reconcile.add_argument("--agent-id", default=None)
    reconcile.add_argument("--dry-run", action="store_true")
    reconcile.set_defaults(func=cmd_reconcile)

    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        return int(args.func(args))
    except ApiError as error:
        payload = error.payload
        if isinstance(payload, dict):
            print(json.dumps(payload, indent=2), file=sys.stderr)
        else:
            print(str(payload), file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
