SOUL_VERSION_RE = re.compile(r"soul\s+v(\d+)", re.IGNORECASE)
SOUL_UPDATED_RE = re.compile(r"soul\s+updated\s+to\s+v(\d+)", re.IGNORECASE)
AUDIT_RECONCILED_SUFFIX_RE = re.compile(r"\s*\[Reconciled under soul v[^\]\n]*\][\s\S]*$", re.IGNORECASE)
AUDIT_FEEDBACK_SUFFIX_RE = re.compile(r"\s*Feedback addressed:\s*[\s\S]*$", re.IGNORECASE)
WHITESPACE_RE = re.compile(r"\s+")
END_WITH_RE = re.compile(r"(?:end|close|finish)\s+with\s*:?\s*(.+)$", re.IGNORECASE)
SENTENCE_SPLIT_RE = re.compile(r"(?<=[.!?])\s+")
TIGHTEN_KEYWORDS = ("tight", "tighter", "short", "shorter", "trim", "concise", "crisp")
EXPAND_KEYWORDS = ("longer", "expand", "elaborate", "more detail", "add detail", "add context")
TONE_HINTS: dict[str, tuple[str, ...]] = {
    "direct": ("direct", "blunt", "straight", "to the point"),
    "casual": ("casual", "conversational", "colloquial"),
    "formal": ("formal", "polished"),
    "professional": ("professional", "executive"),
    "friendly": ("friendly", "warm", "human"),
    "deadpan": ("deadpan", "sarcastic", "dry", "wry", "snark"),
    "playful": ("funny", "funnier", "humorous", "playful", "joke"),
}
ACTIONABLE_KEYWORDS = (
